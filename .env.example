# Copia a .env: docker compose lo lee solo. Para Playwright, exporta las variables en tu terminal.
SECURE_MODE=false
ZAP_API_KEY=taller-dast-key
ZAP_ENABLED=true
ZAP_PROXY=http://localhost:8090
ZAP_TARGET=http://app:3000
# Riesgos que rompen el pipeline (coma separada): High,Medium,Low,Informational
ZAP_FAIL_ON=High,Medium
